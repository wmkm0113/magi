	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.1</version>
				<dependencies>
					<dependency>
						<groupId>org.nervousync</groupId>
						<artifactId>utils-all</artifactId>
						<version>1.3.0</version>
					</dependency>
				</dependencies>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<promoteTransitiveDependencies>false</promoteTransitiveDependencies>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/MANIFEST.MF</exclude>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
							<artifactSet>
								<includes>
									<include>org.nervousync:magi-*</include>
								</includes>
								<excludes>
									<exclude>org.nervousync:magi-derby-*</exclude>
									<exclude>org.nervousync:magi-test-*</exclude>
								</excludes>
							</artifactSet>
							<transformers>
								<transformer implementation="org.nervousync.shade.resource.XmlPropertiesTransformer">
									<filePaths>
										<filePath>META-INF/Resources.xml</filePath>
										<filePath>META-INF/ErrorCode.xml</filePath>
									</filePaths>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<manifestEntries>
										<Built-By>${project.organization.name}</Built-By>
										<Build-Jdk>${java.vm.name} ${java.vendor.version} (${java.runtime.version})
										</Build-Jdk>
										<Implementation-Vendor-Id>${project.groupId}</Implementation-Vendor-Id>
										<X-Compile-Source-JDK>${maven.compiler.source}</X-Compile-Source-JDK>
										<X-Compile-Target-JDK>${maven.compiler.target}</X-Compile-Target-JDK>
									</manifestEntries>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
								<transformer implementation="org.nervousync.shade.resource.SchemaMappingResourceTransformer" />
								<transformer implementation="org.nervousync.shade.resource.I18nResourceTransformer">
									<groupId>org.nervousync</groupId>
									<bundle>magi</bundle>
								</transformer>
							</transformers>
							<createSourcesJar>true</createSourcesJar>
							<shadeSourcesContent>true</shadeSourcesContent>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>${maven.javadoc.version}</version>
				<executions>
					<execution>
						<phase>package</phase>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<includeDependencySources>true</includeDependencySources>
					<dependencySourceIncludes>
						<dependencySourceInclude>org.nervousync:magi-*</dependencySourceInclude>
					</dependencySourceIncludes>
					<dependencySourceExcludes>
						<dependencySourceExclude>org.nervousync:magi-derby-*</dependencySourceExclude>
						<dependencySourceExclude>org.nervousync:magi-test-*</dependencySourceExclude>
					</dependencySourceExcludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
