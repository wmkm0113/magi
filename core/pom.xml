    <artifactId>magi-core</artifactId>
    <packaging>jar</packaging>
    <name>Nervousync ORM Framework Core Module</name>
    <description>Magi Data Platform Middleware Core Module</description>
    <url>https://nervousync.org/projects/magi/core/index.shtml</url>
    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <organization>
        <url>https://nervousync.org/</url>
        <name>Nervousync Studio</name>
    </organization>
    <developers>
        <developer>
            <name>Steven Wee</name>
            <email>wmkm0113@gmail.com</email>
            <url>https://nervousync.org/member/wmkm0113</url>
            <organization>Nervousync Studio</organization>
            <organizationUrl>https://nervousync.org/index.shtml</organizationUrl>
        </developer>
    </developers>
    <properties>
        <bytebuddy.version>1.18.7</bytebuddy.version>
